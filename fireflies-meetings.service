[Unit]
Description=Fireflies.ai meetings FUSE filesystem
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# fusermount3 is at /run/wrappers/bin (NixOS setuid wrapper). Absolute path
# because systemd's user-service PATH lookup for ExecStart* is minimal —
# even 'fusermount3' with Environment=PATH=... doesn't resolve.
WorkingDirectory=%h/agentic/fireflies-meetings-fuse
EnvironmentFile=%h/agentic/fireflies-meetings-fuse/.env
ExecStartPre=-/run/wrappers/bin/fusermount3 -uz /views/fireflies-meetings
ExecStart=%h/agentic/fireflies-meetings-fuse/.venv/bin/fireflies-meetings mount
ExecStop=/run/wrappers/bin/fusermount3 -u /views/fireflies-meetings
ExecStopPost=-/run/wrappers/bin/fusermount3 -u /views/fireflies-meetings
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
